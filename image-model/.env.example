# Copy these into the image-model service environment (EasyPanel/Docker).
# These control speed/resource usage only; face-detection behavior stays the same.

PROCESS_NICE=7
SCAN_YIELD_MS=5
SOURCE_FETCH_TIMEOUT_SECONDS=20
WORKER_COUNT=1
# Limits only heavy face requests inside FastAPI; /health is never blocked by it.
FACE_REQUEST_CONCURRENCY=2

# Recommended current model settings
MODEL_NAME=buffalo_s
DETECTION_SIZE=960
DETECTION_THRESHOLD=0.20
GROUP_SCAN=true
MIRROR_SCAN=true
TILE_SIZE=896
TILE_OVERLAP=320
MAX_TILES=48
MAX_IMAGE_SIDE=3200
MIN_FACE_SIZE=6
MAX_UPLOAD_MB=80

# Set this to the same secret configured in the Nest backend.
API_KEY=replace-with-a-long-random-secret
