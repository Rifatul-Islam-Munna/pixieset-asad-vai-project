# Backend API origin. Keep localhost for local development; set the deployed
# frontend's NEXT_PUBLIC_BASE_URL to https://ai-photo-book-moment-backend.wrtsxa.easypanel.host.
BASE_URL=http://localhost:4000
NEXT_PUBLIC_BASE_URL=http://localhost:4000
NEXT_PUBLIC_ROOT_DOMAIN = http://localhost:3000
# Local Next.js routing can stay localhost. Backend public Studio Manager
# links use STUDIO_PUBLIC_ROOT_DOMAIN=gallerista.app in backend/.env.
# On the deployed frontend, set NEXT_PUBLIC_ROOT_DOMAIN=https://gallerista.app
# and configure wildcard DNS/TLS so studio-slug.gallerista.app reaches this app.
# Same OAuth 2.0 Web client ID used by backend.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com

# VIP Support live chat
NEXT_PUBLIC_SUPPORT_WS_URL=http://localhost:4000

# Chatwoot support widget
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://chat-chatwoot.wrtsxa.easypanel.host
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=SpR7FXRQ4JExuVFPUjUjdwUD

# Generate once, store as a secret, and reuse across all frontend builds/replicas.
# Example generator: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-secret
