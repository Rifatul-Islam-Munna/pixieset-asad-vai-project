MONGODB_URL=mongodb://127.0.0.1:27017/pixieset-asad-vai-project
ACCESS_TOKEN=replace-with-long-random-secret
# Public backend origin used for absolute asset URLs such as uploaded watermark logos.
PUBLIC_API_URL=https://api.example.com
ADMIN_EMAIL=test@gmail.com
ADMIN_PASSWORD=11111111

# Global SMTP email delivery
# Required: SMTP_HOST and SMTP_FROM. Add SMTP_USER + SMTP_PASS when your provider requires authentication.
# Standard STARTTLS setup (recommended for port 587):


# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_STARTTLS=true
# SMTP_REQUIRE_TLS=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-character-google-app-password
# SMTP_FROM=Gallerista <your-account@gmail.com>
# For port 465 instead, use SMTP_PORT=465, SMTP_SECURE=true, SMTP_STARTTLS=false.

# Same OAuth 2.0 Web client ID used by frontend.
GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com

# Cloudflare R2 / S3-compatible object storage
# New gallery photos are original-only and upload directly to the PRIVATE bucket.
# You may point STORAGE_S3_URL at gallarista-private. STORAGE_PUBLIC_BUCKET keeps
# legacy/public assets readable while older photos without originals still exist.
STORAGE_S3_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/gallarista-private
STORAGE_ACCESS_KEY=your-r2-access-key-id
STORAGE_SECRET_KEY=your-r2-secret-access-key
STORAGE_PRIVATE_BUCKET=gallarista-private
STORAGE_PUBLIC_BUCKET=gallarista
# Keep this only for legacy/public assets. New gallery images are served by imagor.
# DO NOT point this at gallarista-private or the private R2 S3 API. The private
# bucket stays private and imagor reads it through the read-only S3 loader below.
STORAGE_PUBLIC_URL=https://pub-YOUR_ID.r2.dev
# Optional overrides:
# STORAGE_REGION=auto
# STORAGE_FORCE_PATH_STYLE=true

# Legacy MinIO variables are still supported when STORAGE_* is not set.
# MINIO_URL=http://localhost:9000
# MINIO_REGION=us-east-1
# MINIO_BUCKET=gallerista.app
# MINIO_ACCESS_KEY=admin
# MINIO_SECRET_KEY=admin12345
# MINIO_FORCE_PATH_STYLE=false

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
IMAGE_MODEL_URL=http://127.0.0.1:8010
IMAGE_MODEL_API_KEY=change-this-to-a-long-random-secret
IMAGE_MODEL_QDRANT_COLLECTION=album_faces_insightface

# Face clustering & search thresholds (tuned for buffalo_s model).
# Lower values = more aggressive merging of same-person faces.
# Raise if different people get merged; lower if same person stays split.
FACE_CLUSTER_SIMILARITY=0.16
FACE_CLUSTER_PAIR_SIMILARITY=0.16
FACE_CLUSTER_CONFLICT_SIMILARITY=0.35
FACE_PERSON_SIMILARITY=0.16
FACE_GLOBAL_PERSON_SIMILARITY=0.24

# Low-pressure face indexing. One inference runs at a time, so RAM stays bounded.
# Normal backlog gets a short breather; a gallery whose Face panel is open gets
# a much smaller gap without adding inference concurrency.
FACE_BACKGROUND_START_DELAY_MS=10000
FACE_BACKGROUND_GAP_MS=750
FACE_ACTIVE_BACKGROUND_GAP_MS=250
FACE_MODEL_HEALTH_TIMEOUT_MS=5000
FACE_MODEL_SCAN_TIMEOUT_MS=60000
FACE_REINDEX_COOLDOWN_HOURS=24
FACE_INDEX_USE_THUMBNAIL=true
FACE_SIDEBAR_DUPLICATE_SIMILARITY=0.22
FACE_SIDEBAR_CONFLICT_DUPLICATE_SIMILARITY=0.24
FACE_MATCH_SIMILARITY=0.32
FACE_SEARCH_SCAN_LIMIT=100000

# VIP Support live chat
SUPPORT_USER_COOLDOWN_SECONDS=20
SUPPORT_MESSAGE_TTL_DAYS=10

# Backend production process scaling. PM2 cluster mode runs three Node workers,
# letting the API use up to roughly three CPU cores under load while leaving
# capacity for imagor, MongoDB, the frontend, and the OS. Only PM2 instance 0
# runs scheduled/background queues.
BACKEND_WEB_CONCURRENCY=3

# Keep Sharp background work bounded per backend worker so the three API workers
# cannot accidentally consume all eight VPS cores.
SHARP_BACKGROUND_CONCURRENCY=1
SHARP_CACHE_MEMORY_MB=16

# Background image finalization. Large or backlogged originals are published raw
# instead of making gallery availability wait on Sharp.
IMAGE_BACKGROUND_PROCESSING_CONCURRENCY=3
IMAGE_BACKGROUND_RAW_FALLBACK_MIN_BYTES=20971520
IMAGE_BACKGROUND_RAW_FALLBACK_AFTER_MS=30000

# Background AI image metadata
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# imagor public delivery. IMAGOR_URL should be the Cloudflare-proxied image
# hostname (for example https://img.gallerista.app), not the VPS IP. Signed URLs
# are deterministic and cheap to create; cache the image bytes, not the URL in MongoDB.
IMAGOR_URL=https://img.example.com
# Optional server-to-server origin used only by the backend for imagor metadata.
# In EasyPanel this can be the private service URL, e.g. http://imagor:8000.
IMAGOR_INTERNAL_URL=http://imagor:8000
IMAGOR_SECRET=replace-with-long-random-secret
IMAGOR_SIGNER_TYPE=sha256
IMAGOR_SIGNER_TRUNCATE=40
# Tiny thumbnail is on-demand only and is not part of the permanent warm set.
IMAGOR_THUMB_WIDTH=320
IMAGOR_THUMB_HEIGHT=320
IMAGOR_THUMB_QUALITY=45
# Only these two AVIF delivery copies are permanently warmed to Result Storage.
IMAGOR_SMALL_WIDTH=720
IMAGOR_SMALL_HEIGHT=720
IMAGOR_SMALL_QUALITY=60
IMAGOR_VIEW_WIDTH=1800
IMAGOR_VIEW_HEIGHT=1800
IMAGOR_VIEW_QUALITY=68
# IMPORTANT: all R2 Result Storage, cache warming, result-public URL, cache TTL,
# and Cloudflare purge settings live on the Imagor app itself.
# See deploy/imagor/.env.example. The backend never downloads transformed
# image bytes from Imagor and never uploads those transformed bytes to R2.
