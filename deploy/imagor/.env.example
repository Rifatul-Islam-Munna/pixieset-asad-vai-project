# The backend never copies transformed image bytes to R2.
IMAGOR_SECRET=replace-with-the-same-secret-used-by-backend

# The cache worker runs inside this Imagor container and only exchanges tiny job metadata with backend.
BACKEND_INTERNAL_URL=http://backend:4000
IMAGOR_LOCAL_URL=http://127.0.0.1:8000
IMAGOR_CACHE_WORKER_ENABLED=true
# Two independent image jobs keep ~2 CPU cores busy while VIPS_CONCURRENCY=1.
# This is the recommended setting for a 3-core Imagor allocation: much faster
# than one-by-one warming while leaving one core of headroom for live traffic.
IMAGOR_CACHE_WORKER_CONCURRENCY=2
# Small pause only between successful jobs. Do not use the old 20s value for
# large libraries; that adds hours of artificial idle time.
IMAGOR_CACHE_WORKER_INTERVAL=250ms
IMAGOR_CACHE_WORKER_IDLE_POLL=2s

# Logging: false means no cache-worker success/error/debug spam.
IMAGOR_CACHE_WORKER_LOG_ENABLED=false
# Imagor's own request/access logs are separate from the cache worker.
# Keep these off in production; enable only while diagnosing.
DEBUG=0
SERVER_ACCESS_LOG=0

# Private originals - Imagor reads these directly from R2.
S3_LOADER_BUCKET=gallarista-private
# IMPORTANT: this is the authenticated R2 S3 API endpoint, NOT r2.dev.
# Normal bucket: https://ACCOUNT_ID.r2.cloudflarestorage.com
# EU jurisdiction bucket: https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
S3_LOADER_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_LOADER_REGION=auto
AWS_LOADER_ACCESS_KEY_ID=
AWS_LOADER_SECRET_ACCESS_KEY=

# Processed results - Imagor itself writes these directly to R2.
S3_RESULT_STORAGE_BUCKET=gallarista-image-cache
S3_RESULT_STORAGE_BASE_DIR=processed-v1
# IMPORTANT: this must also be the authenticated S3 API endpoint.
# Never put the public r2.dev/custom-domain URL in S3_RESULT_STORAGE_ENDPOINT.
S3_RESULT_STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_RESULT_STORAGE_REGION=auto
AWS_RESULT_STORAGE_ACCESS_KEY_ID=
AWS_RESULT_STORAGE_SECRET_ACCESS_KEY=

# Public READ URL for already-cached processed results.
# For testing this can be the bucket's Public Development URL:
# https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# For production prefer a custom domain such as https://cache.example.com
S3_RESULT_STORAGE_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Keep small/view AVIF objects persistent. Do NOT set a global Result Storage
# expiration if these are your permanent delivery copies; deleting an image
# explicitly removes its original + permanent cache + on-demand thumbnail.

# Optional edge purge. Keep these on Imagor, not backend.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
