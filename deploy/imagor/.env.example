# Add these variables to the EXISTING Imagor EasyPanel app.
# The backend never copies transformed image bytes to R2.
IMAGOR_SECRET=replace-with-the-same-secret-used-by-backend

# The cache worker runs inside this Imagor container and only exchanges tiny job metadata with backend.
BACKEND_INTERNAL_URL=http://backend:4000
IMAGOR_LOCAL_URL=http://127.0.0.1:8000
IMAGOR_CACHE_WORKER_ENABLED=true
IMAGOR_CACHE_WORKER_INTERVAL=20s
IMAGOR_CACHE_WORKER_IDLE_POLL=5s

# Private originals - Imagor reads these directly from R2.
S3_LOADER_BUCKET=gallarista-private
S3_LOADER_ENDPOINT=https://YOUR_ACCOUNT_ID.eu.r2.cloudflarestorage.com
AWS_LOADER_REGION=auto
AWS_LOADER_ACCESS_KEY_ID=
AWS_LOADER_SECRET_ACCESS_KEY=

# Processed results - Imagor itself writes these directly to R2.
S3_RESULT_STORAGE_BUCKET=gallarista-image-cache
S3_RESULT_STORAGE_BASE_DIR=processed-v1
S3_RESULT_STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.eu.r2.cloudflarestorage.com
S3_RESULT_STORAGE_PUBLIC_URL=https://cache.example.com
S3_RESULT_STORAGE_EXPIRATION=600h
AWS_RESULT_STORAGE_REGION=auto
AWS_RESULT_STORAGE_ACCESS_KEY_ID=
AWS_RESULT_STORAGE_SECRET_ACCESS_KEY=

# Optional edge purge. Keep these on Imagor, not backend.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
