# Android emulator: localhost is automatically mapped to 10.0.2.2.
# For a physical phone, use your computer LAN IP or the deployed HTTPS API URL.
API_URL=http://localhost:4000

# Web app origin, used to build public gallery links.
WEB_URL=http://localhost:3000


# Dev only: show bundled stock photos when a gallery photo can't load.
# Set to false before a release build.
SAMPLE_IMAGES=false
